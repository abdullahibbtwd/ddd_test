{
  "name": "ddcrm",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "turbo run dev dev:worker",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.dev.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.dev.yml logs -f",
    "prod:up": "docker compose -f infra/docker-compose.yml --env-file .env.production up -d --build",
    "prod:down": "docker compose -f infra/docker-compose.yml --env-file .env.production down",
    "prod:logs": "docker compose -f infra/docker-compose.yml --env-file .env.production logs -f",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @ddcrm/api db:migrate",
    "db:deploy": "pnpm --filter @ddcrm/api db:deploy",
    "db:studio": "pnpm --filter @ddcrm/api db:studio",
    "openapi": "pnpm --filter @ddcrm/api openapi",
    "api:client": "pnpm openapi && pnpm --filter @ddcrm/web api:generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "turbo": "2.11.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
