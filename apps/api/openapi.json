                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "meta": {
                  "nullable": true
                },
                "requestId": {
                  "type": "string",
                  "nullable": true
                },
                "ip": {
                  "type": "string",
                  "nullable": true
