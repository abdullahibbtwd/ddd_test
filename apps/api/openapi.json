                "actorLabel": {
                  "type": "string",
                  "nullable": true
                },
                "actorName": {
                  "type": "string",
                  "nullable": true
                },
                "action": {
                  "type": "string"
                },
                "entityType": {
                  "type": "string"
                },
                "entityId": {
                  "type": "string",
                  "nullable": true
                },
