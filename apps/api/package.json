{
  "name": "@ddcrm/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint \"{src,scripts,test,prisma}/**/*.{ts,tsx,mjs}\" --ignore-pattern \"src/generated/**\"",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && vitest run",
    "openapi": "tsx scripts/generate-openapi.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "cli:create-admin": "tsx src/cli/create-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1167.0",
    "@aws-sdk/s3-request-presigner": "3.1167.0",
    "@bull-board/api": "9.13.0",
    "@bull-board/fastify": "9.13.0",
    "@bull-board/ui": "9.13.0",
    "@casl/ability": "7.1.3",
    "@ddcrm/shared": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "10.1.10",
    "@nestjs/bullmq": "12.0.1",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/platform-fastify": "12.5.0",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.3.1",
    "argon2": "0.45.2",
    "bullmq": "6.7.5",
    "dotenv": "18.0.10",
    "fastify": "5.12.8",
    "ioredis": "5.8.2",
    "nestjs-pino": "5.3.1",
    "nestjs-zod": "5.6.0",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "pino-http": "11.0.0",
    "prisma": "7.10.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "12.5.0",
    "@swc/core": "1.16.22",
    "@testcontainers/postgresql": "11.12.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "7.0.2",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/uuid": "10.0.0",
    "pino-pretty": "13.1.3",
    "testcontainers": "11.12.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "unpdf": "2.1.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
