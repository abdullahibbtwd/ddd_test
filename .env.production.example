# Copy to `.env.production` and replace every CHANGE_ME / REPLACE value.
# Never commit `.env.production`.

# --- Public site (Caddy) ------------------------------------------------------
# Real domain (e.g. crm.example.com) → automatic TLS. Leave CADDY_AUTO_HTTPS empty.
# Local production-like HTTP: quote the bind address and disable auto HTTPS.
# (Unquoted http://… values are awkward for Compose/dotenv.)
SITE_ADDRESS=":80"
CADDY_AUTO_HTTPS="auto_https off"
# Browser origin(s) allowed by the API (comma-separated).
CORS_ORIGIN=http://localhost
# Canonical public site origin (no trailing slash). Used by OriginGuard.
APP_URL=http://localhost

# Auth — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_LONG_SECRET
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=ddcrm
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ddcrm
# Used by api/worker/migrate (host `postgres` is the compose service name).
DATABASE_URL=postgresql://ddcrm:CHANGE_ME@postgres:5432/ddcrm

# --- Redis / BullMQ -----------------------------------------------------------
REDIS_URL=redis://redis:6379
BULLMQ_PREFIX=bull

# --- API process --------------------------------------------------------------
NODE_ENV=production
API_PORT=3000
# Caddy is the only published hop — trust exactly one X-Forwarded-For entry.
TRUST_PROXY_HOPS=1


# --- Garage / S3 (fill after `./infra/garage/init-prod.sh`, or import known keys) ---
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=ddcrm

# --- Gotenberg ----------------------------------------------------------------
GOTENBERG_URL=http://gotenberg:3000

# --- SMTP (client's real mail server — no Mailpit in production compose) ------
SMTP_HOST=CHANGE_ME.example.com
SMTP_PORT=587
SMTP_FROM=noreply@CHANGE_ME.example.com
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
