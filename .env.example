# API
NODE_ENV=development
API_PORT=3000
# Public web origin (OriginGuard + APP_URL). Vite in dev.
APP_URL=http://localhost:5173
DATABASE_URL=postgresql://ddcrm:ddcrm@localhost:5432/ddcrm
# Comma-separated. Include both localhost and 127.0.0.1 if you use either in the browser.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Reverse-proxy hops to trust for client IP (0 in direct/dev; 1 behind Caddy).
TRUST_PROXY_HOPS=0

# Auth (JWT access secret must be ≥32 characters; never commit real secrets)
JWT_ACCESS_SECRET=dev-only-change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Redis / Worker
REDIS_URL=redis://localhost:6379
BULLMQ_PREFIX=bull

# Bull Board is at /api/admin/queues and uses the admin session cookie (no basic auth).

# Web — same-origin via Vite proxy. OpenAPI paths already include `/api`, so the
# base URL is empty (not `/api`) to avoid `/api/api/...`.
VITE_API_URL=

# Garage (S3-compatible) — private bucket; access via API or short-lived presigned URLs
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_ACCESS_KEY=GK1a8654f7fb58addb3de946bdb93f8ec3
S3_SECRET_KEY=a732024340d909fe07cb7b20a7ff68fc97c5f13f0e54f712df4f3360b5dd8fd3
S3_BUCKET=ddcrm

# Gotenberg
GOTENBERG_URL=http://localhost:3001

# Mail (Mailpit in development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@ddcrm.local
# SMTP_SECURE defaults to true when SMTP_PORT=465, otherwise false (STARTTLS / plain for Mailpit)
SMTP_SECURE=false
# Optional SMTP auth (leave unset for Mailpit)
# SMTP_USER=
# SMTP_PASSWORD=
